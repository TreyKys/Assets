<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:kul="be.kuleuven.utils"
	xmlns:l="sap.ui.layout"><Dialog title="Add higher education" contentWidth="50%"><content><f:SimpleForm id="HigherForm" minWidth="1024" maxContainerCols="2" editable="true" title="" layout="ResponsiveGridLayout" labelSpanL="4"
				labelSpanM="4" emptySpanL="2" emptySpanM="2" columnsL="1" columnsM="1"><Label text="{i18n>country}"  required="true"/><kul:AddressSearchCountry id="_searchCountryHigher" groupId ="higher" countryCode="{higherNew>/country}" countryName="{higherNew>/countryTxt}"/><Label text="{i18n>starting_year}"/><Input id="higherStartingYear" value="{higherNew>/startingYear}"/><Label text="{i18n>graduation_year}" required="true"/><Select id="gradYearCombo" selectedKey="{higherNew>/graduationYear}" forceSelection="false"/><Label text="{i18n>school_name}" /><Input id="higherNameSchool" value="{higherNew>/nameSchool}" required="true"/><Label text="{i18n>program_name}"/><Input id="higherNameProgram" value="{higherNew>/nameProgram}" required="true"/><Label text="{i18n>languageDegree}"/><ComboBox id="higherTaalDiploma" selectedKey="{higherNew>/taalDiploma}" required="true"/><Label text="{i18n>degree}" required="true"/><Select id="degreeCombo" selectedKey="{higherNew>/degree}" forceSelection="false"/><Label text="{i18n>result}"/><Input id="higherResult" value="{higherNew>/result}"/></f:SimpleForm></content><beginButton><Button text="Save" press="onAddHigherEduSave"/></beginButton><endButton><Button text="Cancel" press="onAddHigherEduCancel"/></endButton></Dialog></core:FragmentDefinition>