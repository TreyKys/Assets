<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:kul="be.kuleuven.utils"
	xmlns:l="sap.ui.layout"><Dialog title="{i18n>addInterrupt}" contentWidth="50%"><content><f:SimpleForm id="InterruptForm" minWidth="1024" maxContainerCols="2" editable="true" title="" layout="ResponsiveGridLayout" labelSpanL="4"
				labelSpanM="4" emptySpanL="2" emptySpanM="2" columnsL="1" columnsM="1"><Label text="{i18n>from_until}"/><DatePicker id="dateInterFrom"
					value="{path: 'interruptNew>/interruptedStart', type: 'sap.ui.model.type.Date', formatOptions: { UTC: true, pattern: 'dd-MM-yyyy' }}"
					valueFormat="yyyyMMdd" displayFormat="dd.MM.yyyy" required="true"/><DatePicker id="dateInterUntill"
					value="{path: 'interruptNew>/interruptedEnd', type: 'sap.ui.model.type.Date', formatOptions: { UTC: true, pattern: 'dd-MM-yyyy' }}"
					valueFormat="yyyyMMdd" displayFormat="dd.MM.yyyy" required="true"/><Label text="{i18n>reason}" required="true"/><Select id="inpInterReason" selectedKey="{interruptNew>/interruptedReason}"><items><core:Item key="" text=""/><core:Item key="01" text="{i18n>work}"/><core:Item key="02" text="{i18n>exchange}"/><core:Item key="03" text="{i18n>otherStudies}"/><core:Item key="09" text="{i18n>others}"/></items></Select><Label text="{i18n>specify}"/><Input id="interOtherReason" value="{interruptNew>/interruptedReasonOther}" visible="{= ${interruptNew>/interruptedReason} === '09'}"/></f:SimpleForm></content><beginButton><Button text="Save" press="onAddInterruptSave"/></beginButton><endButton><Button text="Cancel" press="onAddInterruptCancel"/></endButton></Dialog></core:FragmentDefinition>