<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form"
	controllerName="be.kuleuven.application.controller.PersInf" xmlns:html="http://www.w3.org/1999/xhtml" xmlns:kul="be.kuleuven.utils"><Page title="{i18n>pers_data}" showNavButton="false" ><landmarkInfo><PageAccessibleLandmarkInfo
			  contentRole="Main"
			  headerRole="Banner"
			  footerRole="Navigation" /></landmarkInfo><headerContent><Button id="logOutPersInf" text="{i18n>logOut}" type="Accept" press="onLogOutPress" icon="sap-icon://log"/></headerContent><content><f:SimpleForm id="PersonalDetailsForm" maxContainerCols="2" editable="true" title="{i18n>pers_details}" layout="ResponsiveGridLayout"
				labelSpanL="4" labelSpanM="4" emptySpanL="2" emptySpanM="2" columnsL="1" columnsM="1"><f:content><Label text="{i18n>natio}" required="true" labelFor="_searchNatio1" /><kul:AddressSearchNationality id="_searchNatio1" groupId="natio1" countryCodeNationality="{personalInfo>/nationality1}"
						editable="{= ${applicant>/isEditable} }" enabled="{= ${applicant>/isEditable} }" suggestionItemSelected="onNatioChange" ><kul:layoutData><l:GridData span="L3 M2 S2"/></kul:layoutData></kul:AddressSearchNationality><Label text="{i18n>natio2}" labelFor="_searchNatio2" /><kul:AddressSearchNationality id="_searchNatio2" groupId="natio2" countryCodeNationality="{personalInfo>/nationality2}"
						editable="{= ${applicant>/isEditable} }" enabled="{= ${applicant>/isEditable} }"><kul:layoutData><l:GridData span="L3 M2 S2"/></kul:layoutData></kul:AddressSearchNationality><Label text="{i18n>permit_question}" labelFor="permitSwitch" /><Switch id="permitSwitch" state="{personalInfo>/hasBelgianResPerm}" customTextOff="{i18n>no}" customTextOn="{i18n>yes}" type="Default"
						enabled="{= ${applicant>/isEditable} }" visible="{= ${personalInfo>/nationality1} !== 'BE'}" change="onPermitSwitchChange"/><Label id="lbl_insz" required="{= ${personalInfo>/nationality1} === 'BE' || ${personalInfo>/hasBelgianResPerm} }" text="{i18n>insz}"
						visible="{= ${personalInfo>/nationality1} === 'BE' || ${personalInfo>/hasBelgianResPerm} }" labelFor="inp_insz" /><HBox><Input id="inp_insz" type="Number" required="{= ${personalInfo>/nationality1} === 'BE' || ${personalInfo>/hasBelgianResPerm} }"
							visible="{= ${personalInfo>/nationality1} === 'BE' || ${personalInfo>/hasBelgianResPerm} }" value="{personalInfo>/ssn}"
							editable="{= ${applicant>/isEditable} }"></Input><ToolbarSpacer width="20px"/><core:Icon id="but_insz" size="2rem" src="sap-icon://message-information" press="onInfoSsnPress"
							visible="{= ${personalInfo>/nationality1} === 'BE' || ${personalInfo>/hasBelgianResPerm} }"></core:Icon></HBox><Label text="{i18n>name}" required="true" labelFor="persInfName" /><Input id="persInfName" required="true" value="{personalInfo>/lastName}" editable="{= ${applicant>/isEditable} }"/><Label text="{i18n>firstname}" required="true" labelFor="persInfFirstName" /><Input id="persInfFirstName" required="true" value="{personalInfo>/firstName}" editable="{= ${applicant>/isEditable} }"></Input><Label text="{i18n>callname}" required="false" visible="{custo>/showCallName}" labelFor="persInfCalltName" /><VBox id="RoepNaamVBox" visible="{custo>/showCallName}"><HBox><Input id="persInfCallName" required="false" value="{personalInfo>/callName}" visible="{custo>/showCallName}" editable="{= ${applicant>/isEditable} }"></Input><core:Icon src="sap-icon://sys-help" height="2.5rem" width="2.5rem" press="handleRoepnaamInfoPress"/></HBox></VBox><Label text="{i18n>email}" required="true" labelFor="persInfEmail" /><Input id="persInfEmail" required="true" type="Email" value="{personalInfo>/email}"/><Label text="{i18n>date_birth}" required="true" labelFor="persInfBirthDate" visible="{= ${personalInfo>/nationality1} !== 'BE' &amp;&amp; ${personalInfo>/hasBelgianResPerm} === false}"/><DatePicker id="persInfBirthDate" visible="{= ${personalInfo>/nationality1} !== 'BE' &amp;&amp; ${personalInfo>/hasBelgianResPerm} === false }"
						value="{path: 'personalInfo>/birthDate', type: 'sap.ui.model.type.Date', formatOptions: { UTC: true, pattern: 'dd-MM-yyyy' }}"
						valueFormat="yyyyMMdd" displayFormat="dd.MM.yyyy" required="true" change="onBirthDateChange" editable="{= ${applicant>/isEditable} }"><layoutData><l:GridData span="L3 M2 S12"/></layoutData></DatePicker><Label text="{i18n>country_birth}" required="true" labelFor="_searchCountryBirth" visible="{= ${personalInfo>/nationality1} !== 'BE' &amp;&amp; ${personalInfo>/hasBelgianResPerm}  === false }"/><kul:AddressSearchCountry id="_searchCountryBirth" visible="{= ${personalInfo>/nationality1} !== 'BE' &amp;&amp; ${personalInfo>/hasBelgianResPerm} === false }" groupId="BirthCountry" countryCode="{personalInfo>/birthCountry}"
						editable="{= ${applicant>/isEditable} }" enabled="{= ${applicant>/isEditable} }" ><kul:layoutData><l:GridData span="L3 M2 S12"/></kul:layoutData></kul:AddressSearchCountry><Label text="{i18n>place_birth}" required="true" labelFor="persInfBirthPlace" visible="{= ${personalInfo>/nationality1} !== 'BE' &amp;&amp; ${personalInfo>/hasBelgianResPerm} === false }" /><Input id="persInfBirthPlace" required="true" value="{personalInfo>/birthPlace}" editable="{= ${applicant>/isEditable} }" visible="{= ${personalInfo>/nationality1} !== 'BE' &amp;&amp; ${personalInfo>/hasBelgianResPerm} === false }"/><Label text="{i18n>sex}" required="true" labelFor="persInfSex" visible="{= ${personalInfo>/nationality1} !== 'BE' &amp;&amp; ${personalInfo>/hasBelgianResPerm} === false }"/><HBox><Select id="persInfSex" selectedKey="{personalInfo>/sex}" enabled="{= ${applicant>/isEditable} }" visible="{= ${personalInfo>/nationality1} !== 'BE' &amp;&amp; ${personalInfo>/hasBelgianResPerm} === false }"><items><core:Item key="" text=""/><core:Item key="1" text="{i18n>male}"/><core:Item key="2" text="{i18n>female}"/><core:Item key="3" text="{i18n>other}"/></items><layoutData><l:GridData span="L2 M2 S2"/></layoutData></Select><ToolbarSpacer width="20px"/><core:Icon id="iconGeslacht" size="2rem" src="sap-icon://message-information" press="onInfoGeslachtPress"
