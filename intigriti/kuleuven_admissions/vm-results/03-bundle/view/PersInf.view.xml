						enabled="{= ${applicant>/isEditable} }" visible="{= ${personalInfo>/nationality1} !== 'BE' }" change="onInBelgiumSwitchChange"/><Label text="" required="true" class="labelForLayout" labelFor="isInBelgium" /><Text id="isInBelgium" text="{i18n>indicate_status}" visible="{personalInfo>/isInBelgium}" /><Label text="" class="labelForLayout" /><CheckBox ariaLabelledBy="isInBelgium" id="chkRef" text="{i18n>rec_refug}" selected="{personalInfo>/isPolRefRec}" visible="{personalInfo>/isInBelgium}"
						select="onRecRefugSelect" enabled="{= ${applicant>/isEditable} }"><layoutData><l:GridData span="L3 M3 S3"/></layoutData></CheckBox><Text id="inpSinceWhentxt" text="{i18n>since_when}" visible="{personalInfo>/isPolRefRec}"><layoutData><l:GridData span="L1 M1 S1"/></layoutData></Text><DatePicker ariaLabelledBy="inpSinceWhentxt" id="dateSinceWhen"
						value="{path: 'personalInfo>/polRefDate', type: 'sap.ui.model.type.Date', formatOptions: { UTC: true, pattern: 'dd-MM-yyyy' }}"
						valueFormat="yyyyMMdd" displayFormat="dd.MM.yyyy" visible="{personalInfo>/isPolRefRec}" editable="{= ${applicant>/isEditable} }"/><Label text="" class="labelForLayout" /><CheckBox id="chkCand" text="{i18n>cand_ref}" selected="{personalInfo>/isPolRefCand}" visible="{personalInfo>/isInBelgium}"
						select="onCandRefSelect" enabled="{= ${applicant>/isEditable} }"/><Label text="" class="labelForLayout" /><CheckBox id="chkFam" text="{i18n>fam_reunion}" selected="{personalInfo>/isFamilyReunion}" visible="{personalInfo>/isInBelgium}"
						select="onFamReunionSelect" enabled="{= ${applicant>/isEditable} }"><layoutData><l:GridData span="L3 M3 S3"/></layoutData></CheckBox><Text id="inpFamtxt" text="{i18n>fam_reunion_who}" visible="{personalInfo>/isFamilyReunion}"><layoutData><l:GridData span="L1 M1 S1"/></layoutData></Text><Input ariaLabelledBy="inpFamtxt" id="fam_input" visible="{personalInfo>/isFamilyReunion}" value="{personalInfo>/familyReunionWith}"
						enabled="{= ${applicant>/isEditable} }"/><Label text="" class="labelForLayout" /><CheckBox id="chkWork" text="{i18n>working}" selected="{personalInfo>/isWorking}" visible="{personalInfo>/isInBelgium}"
						select="onWorkSelect" enabled="{= ${applicant>/isEditable} }"><layoutData><l:GridData span="L3 M3 S3"/></layoutData></CheckBox><Text id="inpWorktxt" text="{i18n>where}" visible="{personalInfo>/isWorking}"><layoutData><l:GridData span="L1 M1 S1"/></layoutData></Text><Input ariaLabelledBy="inpWorktxt" id="work_input" visible="{personalInfo>/isWorking}" value="{personalInfo>/workingWhere}" enabled="{= ${applicant>/isEditable} }"/><Label text="" class="labelForLayout" /><CheckBox id="chkStud" text="{i18n>studying}" selected="{personalInfo>/isStudying}" visible="{personalInfo>/isInBelgium}"
						select="onStudySelect" enabled="{= ${applicant>/isEditable} }"><layoutData><l:GridData span="L3 M3 S3"/></layoutData></CheckBox><Text id="inpStudytxt" text="{i18n>where}" visible="{personalInfo>/isStudying}"><layoutData><l:GridData span="L1 M1 S1"/></layoutData></Text><Input ariaLabelledBy="inpStudytxt" id="study_input" visible="{personalInfo>/isStudying}" value="{personalInfo>/studyingWhere}" editable="{= ${applicant>/isEditable} }"/><Label text="" class="labelForLayout" /><CheckBox id="chkOther" text="{i18n>other_reason}" selected="{personalInfo>/isOtherReason}" visible="{personalInfo>/isInBelgium}"
						select="onOtherSelect" enabled="{= ${applicant>/isEditable} }"><layoutData><l:GridData span="L3 M3 S3"/></layoutData></CheckBox><Text id="inpOtherReasontxt" text="{i18n>specify}" visible="{personalInfo>/isOtherReason}"><layoutData><l:GridData span="L1 M1 S1"/></layoutData></Text><Input ariaLabelledBy="inpOtherReasontxt" id="other_input" visible="{personalInfo>/isOtherReason}" value="{personalInfo>/otherReasonSpecify}"
						editable="{= ${applicant>/isEditable} }"/><Label text="{i18n>additional_remarks}" labelFor="persInfAdditionalRemarks"/><TextArea id="persInfAdditionalRemarks" rows="4" cols="110" maxLength="0" visible="true" value="{personalInfo>/additionalRemarks}"/></f:content></f:SimpleForm></content><footer><Bar design="Auto"><contentMiddle/><contentRight><Button id="persInfoOnUpdatePress" text="{i18n>update}" type="Emphasized" press="onUpdatePress"/><Button text="{i18n>cancel}" press="onNavBack"/></contentRight></Bar></footer></Page></mvc:View>