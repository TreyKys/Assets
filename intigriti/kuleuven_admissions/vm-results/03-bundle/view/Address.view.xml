<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="be.kuleuven.application.controller.Address"
	xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:html="http://www.w3.org/1999/xhtml" xmlns:kul="be.kuleuven.utils"><Page title="{i18n>address_title}"><landmarkInfo><PageAccessibleLandmarkInfo
			  contentRole="Main"
			  headerRole="Banner"
			  footerRole="Navigation" /></landmarkInfo><headerContent><Button id="logOut" text="{i18n>logOut}" type="Accept" press="onLogOutPress" icon="sap-icon://log"/></headerContent><content><f:SimpleForm id="HomeAddressDetailsForm" minWidth="1024" maxContainerCols="2" editable="true" title="{i18n>home_address}"
				layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" emptySpanL="2" emptySpanM="2" columnsL="1" columnsM="1"><f:content><Label text="{i18n>country}" required="true" labelFor="_searchCountryPerAd" /><kul:AddressSearchCountry id="_searchCountryPerAd" groupId="AddrPer" editable="{= ${applicant>/isEditable} }" enabled="{= ${applicant>/isEditable} }"
						countryCode="{addressInfo>/permanentAddress/country}" countryName="{addressInfo>/permanentAddress/country_txt}"/><Label text="{i18n>postal_code}" required="true" labelFor="_searchCityPerAd" /><kul:AddressSearchCity id="_searchCityPerAd" groupId="AddrPer" mode="1" editable="{= ${applicant>/isEditable} }"
						countryCode="{addressInfo>/permanentAddress/country}" postalCode="{addressInfo>/permanentAddress/postalCode}"
						submunicipality="{addressInfo>/permanentAddress/city}" value="{addressInfo>/permanentAddress/postalCode}" enabled="{= ${applicant>/isEditable} }"/><Label text="{i18n>city}" required="true" labelFor="_inputCityPerAd" /><kul:AddressSearchCity id="_inputCityPerAd" groupId="AddrPer" editable="{= ${applicant>/isEditable} }"
						countryCode="{addressInfo>/permanentAddress/country}" postalCode="{addressInfo>/permanentAddress/postalCode}"
						submunicipality="{addressInfo>/permanentAddress/city}" value="{addressInfo>/permanentAddress/city}" enabled="{= ${applicant>/isEditable} }"/><Label text="{i18n>state}" labelFor="_searchStatePerAd" /><kul:AddressSearchState id="_searchStatePerAd" groupId="AddrPer" editable="{= ${applicant>/isEditable} }"
						countryCode="{addressInfo>/permanentAddress/country}" region="{addressInfo>/permanentAddress/state}" enabled="{= ${applicant>/isEditable} }"/><Label text="{i18n>street1}" required="true" labelFor="_searchStreetPerAd" /><kul:AddressSearchStreet id="_searchStreetPerAd" groupId="AddrPer" editable="{= ${applicant>/isEditable} }"
						countryCode="{addressInfo>/permanentAddress/country}" submunicipality="{addressInfo>/permanentAddress/city}"
						streetName="{addressInfo>/permanentAddress/street1}" enabled="{= ${applicant>/isEditable} }"/><Label text="{i18n>street2}" labelFor="permanentAddressStreet2" /><Input id="permanentAddressStreet2" required="false" value="{addressInfo>/permanentAddress/street2}" maxLength="40" editable="{= ${applicant>/isEditable} }"/><Label text="{i18n>street3}" labelFor="permanentAddressStreet3" /><Input id="permanentAddressStreet3" required="false" value="{addressInfo>/permanentAddress/street3}" maxLength="40" editable="{= ${applicant>/isEditable} }"/><Label text="{i18n>number}" required="true" labelFor="permanentAddressHouseNumber" /><Input id="permanentAddressHouseNumber" required="true" value="{addressInfo>/permanentAddress/houseNumber}"
						editable="{= ${applicant>/isEditable} }"><layoutData><l:GridData span="L1 M1 S1"/></layoutData></Input><Label text="{i18n>box}" labelFor="permanentAddressBox"><layoutData><l:GridData linebreak="false" span="L2 M2 S12"></l:GridData></layoutData></Label><Input id="permanentAddressBox" required="false" value="{addressInfo>/permanentAddress/box}" editable="{= ${applicant>/isEditable} }"><layoutData><l:GridData span="L1 M1 S1"/></layoutData></Input><Label text="{i18n>telephone}" labelFor="permanentAddressTelephone" /><Input id="permanentAddressTelephone" required="false" value="{addressInfo>/permanentAddress/telephone}" maxLength="30"/><Label text="{i18n>curr_switch}" labelFor="currAddrSwitch" /><Switch id="currAddrSwitch" state="{addressInfo>/sameCurrentAddress}" customTextOff="{i18n>no}" customTextOn="{i18n>yes}" type="Default"
						enabled="true" visible="true" change="oncurrAddrSwitchChange"/></f:content></f:SimpleForm><f:SimpleForm id="CurrAddressDetailsForm" visible="{= ${addressInfo>/sameCurrentAddress} === false }" minWidth="1024" maxContainerCols="2"
				editable="true" title="{i18n>curr_address}" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" emptySpanL="2" emptySpanM="2"
				columnsL="1" columnsM="1"><f:content><Label text="{i18n>country}" required="true" labelFor="_searchCountryCurAd" /><kul:AddressSearchCountry id="_searchCountryCurAd" groupId="AddrCur" 
					countryCode="{addressInfo>/currentAddress/country}" countryName="{addressInfo>/currentAddress/country_txt}" /><Label text="{i18n>postal_code}" required="true" labelFor="_searchCityCurAd" /><kul:AddressSearchCity id="_searchCityCurAd" groupId="AddrCur" mode="1" countryCode="{addressInfo>/currentAddress/country}" postalCode="{addressInfo>/currentAddress/postalCode}"
						submunicipality="{addressInfo>/currentAddress/city}" value="{addressInfo>/currentAddress/postalCode}" /><Label text="{i18n>city}" required="true" labelFor="_inputCityCurAd" /><kul:AddressSearchCity id="_inputCityCurAd" groupId="AddrCur" countryCode="{addressInfo>/currentAddress/country}" postalCode="{addressInfo>/currentAddress/postalCode}"
						submunicipality="{addressInfo>/currentAddress/city}" value="{addressInfo>/currentAddress/city}" /><Label text="{i18n>state}" labelFor="_searchStateCurAd" /><kul:AddressSearchState id="_searchStateCurAd" groupId="AddrCur" countryCode="{addressInfo>/currentAddress/country}" 
					region="{addressInfo>/currentAddress/state}"/><Label text="{i18n>street1}" required="true" labelFor="_searchStreetCurAd" /><kul:AddressSearchStreet id="_searchStreetCurAd" groupId="AddrCur" countryCode="{addressInfo>/currentAddress/country}" submunicipality="{addressInfo>/currentAddress/city}"
						streetName="{addressInfo>/currentAddress/street1}" /><Label text="{i18n>street2}" labelFor="currentAddressStreet2" /><Input id="currentAddressStreet2" required="false" value="{addressInfo>/currentAddress/street2}" maxLength="40"/><Label text="{i18n>street3}" labelFor="currentAddressStreet3" 	/><Input id="currentAddressStreet3" required="false" value="{addressInfo>/currentAddress/street3}" maxLength="40"/><Label text="{i18n>number}" required="true" labelFor="currentAddressHouseNumber" /><Input id="currentAddressHouseNumber" required="true" value="{addressInfo>/currentAddress/houseNumber}"><layoutData><l:GridData span="L1 M1 S1"/></layoutData></Input><Label text="{i18n>box}" labelFor="currentAddressBox" ><layoutData><l:GridData linebreak="false" span="L2 M2 S12"></l:GridData></layoutData></Label><Input id="currentAddressBox" required="false" value="{addressInfo>/currentAddress/box}"><layoutData><l:GridData span="L1 M1 S1"/></layoutData></Input><Label text="{i18n>telephone}" labelFor="currentAddressTelephone" /><Input id="currentAddressTelephone" required="false" value="{addressInfo>/currentAddress/telephone}" maxLength="30"/></f:content></f:SimpleForm><f:SimpleForm id="EmergencyContactDetailsForm" minWidth="1024" maxContainerCols="2" editable="true" title="{i18n>emerg_contact}"
				layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" emptySpanL="2" emptySpanM="2" columnsL="1" columnsM="1"><f:content><Label text="{i18n>nameIce}" required="true" labelFor="iceContPersLastname" /><Input id="iceContPersLastname" required="true" value="{addressInfo>/contPersLastName}"/><Label text="{i18n>firstnameIce}" required="true" labelFor="iceContPersFirstname" /><Input id="iceContPersFirstname" required="true" value="{addressInfo>/contPersFirstName}"/><Label text="{i18n>telephone}" required="true" labelFor="iceContPersTelephone" /><Input id="iceContPersTelephone" required="true" value="{addressInfo>/contPersTelephone}"/><Label text="{i18n>email}" required="true" labelFor="iceContPersEmail" /><Input id="iceContPersEmail" required="true" value="{addressInfo>/contPersEmail}"/><Label text="{i18n>relation}" required="true" labelFor="iceContPersRelation" /><Input id="iceContPersRelation" required="true" value="{addressInfo>/contPersRelation}"/></f:content></f:SimpleForm><f:SimpleForm id="AddRemarksAddrForm" minWidth="1024" maxContainerCols="2" editable="true" title="{i18n>remarks}"
				layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" emptySpanL="2" emptySpanM="2" columnsL="1" columnsM="1"><Label text="{i18n>additional_remarks}" labelFor="addressAdditionalRemarks" /><TextArea id="addressAdditionalRemarks" rows="4" cols="110" maxLength="0" visible="true" value="{addressInfo>/additionalRemarks}"/></f:SimpleForm></content><footer><Bar design="Auto"><contentMiddle/><contentRight><Button id="addressOnUpdatePress" text="{i18n>update}" type="Emphasized" press="onUpdatePress"/><Button text="{i18n>cancel}" press="onNavBack"/></contentRight></Bar></footer></Page></mvc:View>