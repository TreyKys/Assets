								infoState="{path: 'applicant>/isPersInfoCompleted', formatter: '.formatter.infoStatusTekst'}" icon="sap-icon://person-placeholder"
								iconInset="true" type="Active" press="onPersonalDataPress"/><StandardListItem id="listAdrData" title="{i18n>address_data}" description=" "
								info="{path: 'applicant>/isAddressCompleted', formatter: '.formatter.infoTekst'}"
								infoState="{path: 'applicant>/isAddressCompleted', formatter: '.formatter.infoStatusTekst'}" icon="sap-icon://addresses" type="Active"
								press="onAddressPress"/><StandardListItem id="listCurrData" title="{i18n>curr_data}" description=" "
								info="{path: 'applicant>/isCurriculumCompleted', formatter: '.formatter.infoTekst'}"
								infoState="{path: 'applicant>/isCurriculumCompleted', formatter: '.formatter.infoStatusTekst'}" icon="sap-icon://curriculum" type="Active"
								press="onCurriculumPress"/><StandardListItem id="listLangData" title="{i18n>languages}" description=" "
								info="{path: 'applicant>/isLanguageCompleted', formatter: '.formatter.infoTekst'}"
								infoState="{path: 'applicant>/isLanguageCompleted', formatter: '.formatter.infoStatusTekst'}" icon="sap-icon://form" type="Active"
								press="onLanguagesPress"/></items></List><Title text="" class="title titleForLayout" /><Title text="" class="title titleForLayout" /><List id="appl_list2" items="{ path: 'application>/' , sorter: { path: 'statusCode' } }" mode="Delete" delete="onDeleteApplication"
						noDataText="{i18n>no_data}" ariaLabelledBy="applicationsTitle"><headerToolbar><Toolbar><content><Title id="applicationsTitle" text="{i18n>applications}" class="title" /><ToolbarSpacer/><Button id="addApplication" tooltip="{i18n>add}" icon="sap-icon://add" press="onAddApplication"/></content></Toolbar></headerToolbar><StandardListItem title="{i18n>application} {application&gt;applicationId}: {application>programDescription}"
							description="{path: 'application>statusCode', formatter: '.formatter.statusTekst'}" type="Detail" detailPress="onApplicationDetail"><customData><core:CustomData key="id" value="{application>applicationId}"/><core:CustomData key="status" value="{application>statusCode}"/></customData></StandardListItem></List></items></VBox></content><footer><Bar design="Auto"><contentMiddle/><contentRight/></Bar></footer></Page></mvc:View>