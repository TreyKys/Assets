<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout"
	xmlns:html="http://www.w3.org/1999/xhtml" controllerName="be.kuleuven.application.controller.Main"><Page id="mainPage"><landmarkInfo><PageAccessibleLandmarkInfo
			  contentRole="Main"
			  headerRole="Banner" /></landmarkInfo><customHeader><Bar id="customHeader" class="banner"><contentLeft><Image src="./img/{custo>/imageLeft}" height="100%"/></contentLeft><contentRight><Image src="./img/{custo>/imageRight}" visible="{= ${custo>/organisation} === '51181994' ? true : false}" height="100%"/></contentRight></Bar></customHeader><subHeader></subHeader><content><VBox><items><Panel accessibleRole="Region"><Bar id="barSubHeader" design="Header"><contentMiddle><Title text="{applicant>/firstName} {applicant>/name} ({i18n>username} : {applicant>/inAccountId} )" class="title" /></contentMiddle><contentRight><Button id="chatButtonNoMessages" text="Contact" press="onCommunicationMenuOpen" icon="sap-icon://discussion" 
						            visible="{= ${applicationCommunication>/totalNrUnreadMessages} === 0 &amp;&amp; ${applicationCommunication>/chatButtonVisible}}"/><Button id="chatButton1Message" text="{i18n>1NewMessage}" press="onCommunicationMenuOpen" icon="sap-icon://discussion" 
						            type="Emphasized" visible="{= ${applicationCommunication>/totalNrUnreadMessages} === 1 &amp;&amp; ${applicationCommunication>/chatButtonVisible}}"/><Button id="chatButtonNewMessages" text="{applicationCommunication>/totalNrUnreadMessages} {i18n>newMessages}" press="onCommunicationMenuOpen" icon="sap-icon://discussion" 
						            type="Emphasized" visible="{= ${applicationCommunication>/totalNrUnreadMessages} > 1 &amp;&amp; ${applicationCommunication>/chatButtonVisible}}"/><Link id="langNL" text="NL" press="changeLanguage"/><Link id="langEN" text="EN" press="changeLanguage"/><Button id="logOutMain" text="{i18n>logOut}" type="Accept" press="onLogOutPress" icon="sap-icon://log"/></contentRight></Bar></Panel><Panel accessibleRole="Region"><Image id="applFoto" visible="{custo>/showPhoto}" width="123.9px" height="159.3px" decorative="false" alt="{i18n>upload_picture}"
						    press="onPhotoUpload"/></Panel><Panel accessibleRole="Region"><headerToolbar><Toolbar><Title text="{i18n>information}" class="title" /></Toolbar></headerToolbar><content><HBox><items><FormattedText htmlText="{teksten>/infoText}" width="auto"/><Input id="inputAccount" value="{applicant>/inAccountId}" visible="false"/></items></HBox></content></Panel><List class="sapUiSizeCompact" headerText="{i18n>list_header}"><items><StandardListItem id="listPersData" title="{i18n>pers_data}" description=" "
