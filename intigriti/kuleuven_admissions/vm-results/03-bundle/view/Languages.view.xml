			  headerRole="Banner"
			  footerRole="Navigation" /></landmarkInfo><headerContent><Button id="logOutLang" text="{i18n>logOut}" type="Accept" press="onLogOutPress" icon="sap-icon://log"/></headerContent><content><Table id="languageTable" items="{ path: 'knowModel>/' }" mode="Delete" delete="onDeletePress" ariaLabelledBy="languageKnowledgeTitle"><headerToolbar><Toolbar width="100%"><content><Title id="languageKnowledgeTitle" text="{i18n>language_knowledge}" class="title" /><ToolbarSpacer/><Button tooltip="{i18n>add}" icon="sap-icon://add" press="onAddLanguage"/></content></Toolbar></headerToolbar><columns><Column><header><Text id="textLanguageCol" text="{i18n>language}"/></header></Column><Column><header><Text id="textSpeakingCol" text="{i18n>speaking}"/></header></Column><Column><header><Text id="textWritingCol" text="{i18n>writing}"/></header></Column><Column><header><Text id="textReadingCol" text="{i18n>reading}"/></header></Column><Column><header><Text id="textListeningCol" text="{i18n>listening}"/></header></Column></columns><items><ColumnListItem><cells><Select ariaLabelledBy="textLanguageCol" id="selectLanguages" selectedKey="{knowModel>language}" forceSelection="false"/><Select ariaLabelledBy="textSpeakingCol" id="selectSpeaking" selectedKey="{knowModel>speaking}" forceSelection="false"/><Select ariaLabelledBy="textWritingCol" id="selectWriting" selectedKey="{knowModel>writing}" forceSelection="false"/><Select ariaLabelledBy="textReadingCol" id="selectReading" selectedKey="{knowModel>reading}" forceSelection="false"/><Select ariaLabelledBy="textListeningCol" id="selectListening" selectedKey="{knowModel>listening}" forceSelection="false"/></cells></ColumnListItem></items></Table><f:SimpleForm id="AddRemarksLangForm" minWidth="1024" maxContainerCols="2" editable="true" title="{i18n>remarks}"
