 text="{i18n>graduation_year}"/></Column><Column width="18%" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>school_name}"/></Column><Column width="auto" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>program_name}"/></Column><Column width="auto" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>languageDegree}"/></Column><Column width="15%" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>degree}"/></Column><Column width="10%" demandPopin="true" minScreenWidth="Tablet"><Text text="{i18n>result}"/></Column><Column width="2rem"><Text text=""/></Column><Column width="2rem"><Text text=""/></Column></columns><items><ColumnListItem ><cells><Text id="higherEduCountryTxt" text="{higher>countryTxt}"/><Text id="higherEduStartingYear" text="{higher>startingYear}"/><Text id="higherEduGraduationYear" text="{path: 'higher>graduationYear', formatter: '.formatter.acJaarTekst'}"/><Text id="higherEduNameSchool" text="{higher>nameSchool}"/><Text id="higherEduNameProgram" text="{higher>nameProgram}"/><Text id="higherEduTaal" text="{path: 'higher>taalDiploma', formatter: '.formatter.diplomaTaalTekst'}" /><Text id="higherEduDegree" text="{path: 'higher>degree', formatter: '.formatter.degreeTekst'}"/><Text id="higherEduResult" text="{higher>result}"/><Button id="onHandleHigherEditPress" tooltip="{i18n>edit}" app:mydata="{higher>higherEducationId}" icon="sap-icon://edit" type="Transparent"
