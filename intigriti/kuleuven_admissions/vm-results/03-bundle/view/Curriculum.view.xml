<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:l="sap.ui.layout"
	xmlns:html="http://www.w3.org/1999/xhtml" controllerName="be.kuleuven.application.controller.Curriculum" xmlns:kul="be.kuleuven.utils"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"><Page id="currPage" title="{i18n>title_curriculum}"><landmarkInfo><PageAccessibleLandmarkInfo
			  contentRole="Main"
			  headerRole="Banner"
			  footerRole="Navigation" /></landmarkInfo><headerContent><Button id="logOut" text="{i18n>logOut}" type="Accept" press="onLogOutPress" icon="sap-icon://log"/></headerContent><content><Panel accessibleRole="Form"><headerToolbar><Toolbar id="secundaryInfo" height="3rem"><Title id="priorToHigherEducationTitle" text="{i18n>prior_to_higher_education}" class="title" /><core:Icon id="higher_info" size="1rem" src="sap-icon://message-information" press="onSecundaryInfoPress"></core:Icon></Toolbar></headerToolbar><content><f:SimpleForm id="PriorToHigherEducationForm" minWidth="1024" maxContainerCols="2" editable="true" title="" layout="ResponsiveGridLayout"
						labelSpanL="4" labelSpanM="4" emptySpanL="2" emptySpanM="2" columnsL="1" columnsM="1" ariaLabelledBy="priorToHigherEducationTitle"><f:content><Label text="{i18n>country_degree}" required="true" labelFor="_searchCountryCurr" /><kul:AddressSearchCountry id="_searchCountryCurr" groupId="secOnd" required="true" countryCode="{curriculum>/eduCountry}"
