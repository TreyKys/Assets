										press="onHandleHigherDeletePress" visible="{= ${higher>editable} }"></Button></cells></ColumnListItem></items></Table></content></Panel><Panel accessibleRole="Region" id="ledPanel" visible="false"><headerToolbar><Toolbar id="higherEduLed" height="3rem"><Title id="higherEduLedTitle" text="{i18n>higher_education_led}" class="title" /></Toolbar></headerToolbar><content><Table id="ledTable" items="{ path: 'led>/'}" mode="None" rememberSelections="false" ariaLabelledBy="higherEduLedTitle"><columns><Column><Text text="{i18n>graduation_year}"/></Column><Column><Text text="{i18n>school_name}"/></Column><Column><Text text="{i18n>program_name}"/></Column><Column><Text text="{i18n>degree}"/></Column></columns><items><ColumnListItem ><cells><Text id="higherEduLedGraduationYear" text="{led>graduationYear}"/><Text id="higherEduLedNameSchool" text="{led>nameSchool}"/><Text id="higherEduLedNameProgram" text="{led>nameProgram}"/><Text id="higherEduLedDegree" text="{led>degree}"/></cells></ColumnListItem></items></Table></content></Panel><Panel accessibleRole="Form"><headerToolbar><Toolbar id="interruption" height="3rem"><Title id="interruptionTitle" text="{i18n>interruption}" class="title" /><ToolbarSpacer/></Toolbar></headerToolbar><content><Label id="interruptionQuestion" text="{i18n>interruption_question}" labelFor="interruptionSwitch" /><Switch id="interruptionSwitch" state="{curriculum>/isInterrupted}" customTextOff="{i18n>no}" customTextOn="{i18n>yes}" type="Default"
							enabled="true" visible="true" change="onInterruptionSwitchChange" ariaLabelledBy="interruptionQuestion" /><Table id="interruptTable" items="{ path: 'interrupt>/'}" mode="None" rememberSelections="false" delete="onDeleteInterrupt" visible="{curriculum>/isInterrupted}"><headerToolbar><Toolbar width="100%"><content><Text text="{i18n>interruptList}"/><ToolbarSpacer/><Button tooltip="{i18n>add}" icon="sap-icon://add" press="onAddInterrupt"/></content></Toolbar></headerToolbar><columns><Column><Text id="textFromCol" text="{i18n>from}"/></Column><Column><Text id="textUntilCol" text="{i18n>until}"/></Column><Column><Text id="textReasonCol" text="{i18n>reason}"/></Column><Column width="2rem"><Text text=""/></Column><Column width="2rem"><Text text=""/></Column></columns><items><ColumnListItem ><cells><DatePicker
										ariaLabelledBy="textFromCol"
										id="interruptedStart" value="{path: 'interrupt>interruptedStart', type: 'sap.ui.model.type.Date', formatOptions: { UTC: true, pattern: 'dd-MM-yyyy' }}"
										valueFormat="yyyyMMdd" displayFormat="dd.MM.yyyy" editable="false"/><DatePicker
										ariaLabelledBy="textUntilCol"
										id="interruptedEnd" value="{path: 'interrupt>interruptedEnd', type: 'sap.ui.model.type.Date', formatOptions: { UTC: true, pattern: 'dd-MM-yyyy' }}"
										valueFormat="yyyyMMdd" displayFormat="dd.MM.yyyy" editable="false"/><Input
										ariaLabelledBy="textReasonCol"
										id="interruptedReason" value="{ parts: [ {path: 'interrupt>interruptedReason'}, {path: 'interrupt>interruptedReasonOther'} ], formatter: '.formatter.interruptedReasonText'}"
										editable="false"/><Button id="interruptedId" tooltip="{i18n>add}" app:mydata="{interrupt>interruptedId}" icon="sap-icon://edit" type="Transparent"
										press="onHandleInterruptEditPress"><layoutData><l:GridData span="L1 M1 S1"/></layoutData></Button><Button id="onHandleInterruptDeletePress" tooltip="{i18n>remove}" app:mydata="{interrupt>interruptedId}" icon="sap-icon://sys-cancel" type="Transparent"
										press="onHandleInterruptDeletePress"><layoutData><l:GridData span="L1 M1 S1"/></layoutData></Button></cells></ColumnListItem></items></Table></content></Panel><Panel accessibleRole="Form"><headerToolbar><Toolbar id="currAddRemarks" height="3rem"><Title id="additionalRemarksTitle" text="{i18n>additional_remarks}" class="title" /></Toolbar></headerToolbar><content><f:SimpleForm id="CurrAddRemarksForm" minWidth="1024" maxContainerCols="2" editable="true" title="" layout="ResponsiveGridLayout"
						labelSpanL="4" labelSpanM="4" emptySpanL="2" emptySpanM="2" columnsL="1" columnsM="1" ariaLabelledBy="additionalRemarksTitle"><Label text="{i18n>additional_remarks}" labelFor="currAddRemarkstext" /><TextArea id="currAddRemarkstext" rows="4" cols="110" maxLength="0" visible="true" value="{curriculum>/additionalremarks}"/></f:SimpleForm></content></Panel></content><footer><Bar id="curriculumOnUpdatePress" design="Auto"><contentMiddle/><contentRight><Button id="currSaveBtn" text="{i18n>update}" type="Emphasized" press="onUpdatePress"/><Button text="{i18n>cancel}" press="onNavBack"/></contentRight></Bar></footer></Page></mvc:View>